APP_NAME=DevBox
ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://devbox:devbox@localhost:5432/devbox
API_V1_PREFIX=/api/v1

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
EXECUTOR_SERVICE_TOKEN=replace-this-with-a-long-random-secret

# Per-workspace container limits (applied by the trusted executor service).
WORKSPACE_CPU_LIMIT=1.0
WORKSPACE_MEMORY_LIMIT=1g
WORKSPACE_PIDS_LIMIT=256
