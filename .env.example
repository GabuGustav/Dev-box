APP_NAME=DevBox
ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://devbox:local-development-only@localhost:5432/devbox

# Required by Docker Compose. Generate a unique value for every deployment.
# Use a URL-safe value (letters, numbers, hyphens, underscores).
DB_PASSWORD=replace-with-a-unique-random-secret
# The API is bound to localhost by default. Use 0.0.0.0 only behind a TLS reverse proxy.
API_BIND_ADDRESS=127.0.0.1
API_V1_PREFIX=/api/v1

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
EXECUTOR_SERVICE_TOKEN=replace-this-with-a-long-random-secret
BROKER_SERVICE_TOKEN=replace-this-with-a-different-long-random-secret
LIFECYCLE_RECONCILE_INTERVAL_SECONDS=60

# Per-workspace container limits (applied by the trusted executor service).
WORKSPACE_CPU_LIMIT=1.0
WORKSPACE_MEMORY_LIMIT=1g
WORKSPACE_PIDS_LIMIT=256

# Dedicated Linux XFS mount with project quota enforcement enabled.
# Create/mount this path on the Docker host before starting the worker.
WORKSPACE_STORAGE_ROOT=/srv/devbox/workspaces
WORKSPACE_DISK_QUOTA=10g
WORKSPACE_INODE_LIMIT=200000

# Separate dedicated Linux XFS mount for encrypted snapshots.
SNAPSHOT_STORAGE_ROOT=/srv/devbox/snapshots
SNAPSHOT_DISK_QUOTA=20g
SNAPSHOT_INODE_LIMIT=50000
SNAPSHOT_MAX_COUNT=10
SNAPSHOT_MAX_BYTES=10737418240

# Generate once with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
# Store this key securely. Losing it makes encrypted snapshots unrecoverable.
SNAPSHOT_ENCRYPTION_KEY=

# Verify managed workspace mounts and quotas periodically.
RECONCILE_INTERVAL_SECONDS=60
GIT_OPERATION_TIMEOUT_SECONDS=300
